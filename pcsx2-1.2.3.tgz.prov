Hash: SHA512

annotations:
  artifacthub.io/changes: |
    - kind: added
      description: Chart releases are now signed (helm package --sign) - see artifacthub.io/signKey for the public key location and fingerprint, powers the "Signed" badge on ArtifactHub
  artifacthub.io/changesHistory: |
    - version: 1.2.2
      changes:
        - kind: added
          description: values.schema.json - validates values.yaml against a JSON Schema, and is what powers the "Values schema" feature/badge on ArtifactHub (previously absent)
    - version: 1.2.1
      changes:
        - kind: added
          description: icon, previously missing entirely - pointed at linuxserver.io's own logo image for this app, which is why no image was ever showing on ArtifactHub
    - version: 1.2.0
      changes:
        - kind: added
          description: Add NVIDIA GPU support (gpu.vendor=nvidia, requests nvidia.com/gpu via the NVIDIA Kubernetes device plugin) alongside the existing Intel/AMD VA-API mode
        - kind: added
          description: Add seccompUnconfined to work around a SIGBUS crash in PCSX2's JIT recompiler under Docker/Kubernetes' default seccomp profile on some kernel/libseccomp combinations
        - kind: changed
          description: Bump the default shmSize from 1Gi to 2Gi - PCSX2's JIT recompiler uses a shared-memory-backed "fastmem" mapping that crashes with SIGBUS right after game launch on the previous, smaller default
    - version: 1.1.1
      changes:
        - kind: changed
          description: Clarify the streaming README section - host must be reachable directly by the end user's browser (not cluster-internal DNS), and the container's self-signed cert has no SAN, which some browsers refuse outright
    - version: 1.1.0
      changes:
        - kind: added
          description: Add streaming.enabled/streaming.brokerPort to expose the RomM emulator-streaming broker sidecar port (added via a DOCKER_MODS Docker Mod), for use with docs.romm.app/latest/using/emulator-streaming
    - version: 1.0.0
      changes:
        - kind: added
          description: Initial release of the PCSX2 Helm chart
  artifacthub.io/license: MIT
  artifacthub.io/links: |
